# .env file for Docker Compose
# Copy this to .env and configure with your values

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=changeme_secure_password
MYSQL_DATABASE=dataflow_metadata
MYSQL_USER=root
MYSQL_HOST_PORT=3307

# Application Ports
APP_FRONTEND_PORT=3000
APP_BACKEND_PORT=8000

# Metadata Engine Selection (mysql or postgres)
METADATA_ENGINE=mysql

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API URL for Frontend (used in production)
VITE_API_URL=http://localhost:8000
