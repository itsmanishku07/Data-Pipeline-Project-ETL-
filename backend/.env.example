METADATA_ENGINE=mysql

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=dataflow_metadata

# PostgreSQL Configuration
# Set METADATA_ENGINE=postgres for local PostgreSQL. Databricks Apps uses LAKEBASE_MODE=true.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DATABASE=dataflow_metadata
POSTGRES_SCHEMA=public
POSTGRES_SEARCH_PATH=

# Databricks Lakebase mode (Databricks Apps injects PGHOST/PGPORT/PGUSER/PGDATABASE/PGSSLMODE).
# Set LAKEBASE_ENDPOINT to projects/<project-id>/branches/<branch-id>/endpoints/<endpoint-id>.
# The Databricks SDK uses the app service principal and refreshes OAuth credentials per new connection.
LAKEBASE_MODE=false
LAKEBASE_ENDPOINT=

# Pool sizing: Lakebase handles production database state; keep app connection pools modest.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=1800
DB_CONNECTION_TIMEOUT=15
